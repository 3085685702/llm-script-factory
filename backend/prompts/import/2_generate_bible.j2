        "era": "时代背景",
        "location": "主要地点",
        "social_context": "社会环境"
    },
    "characters": [
        {
            "name": "角色姓名",
            "role": "主角/配角/反派",
            "identity": "身份",
            "personality": "性格特点",
            "goal": "人物目标"
        }
    ],
    "relationships": [
        {
            "characters": ["角色A", "角色B"],
            "relation": "关系类型",
            "description": "关系描述"
        }
    ],
    "plot_hooks": [
        "爽点1：xxx",
